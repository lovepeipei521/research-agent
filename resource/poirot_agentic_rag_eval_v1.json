    {"id":"agent-13","prompt":"请查询本地资料说明 warm pool 的目的，并说明它不解决什么问题。","should_call_knowledge_search":true,"expected_sources":["sandbox.md"],"required_strings":["warm pool","cold-start latency"],"must_not_contain":["warm pool 会替代 Docker 隔离"]},
    {"id":"agent-14","prompt":"请基于本地知识库说明 DockerPathGuard 和 DockerPathTranslator 的职责区别。","should_call_knowledge_search":true,"expected_sources":["sandbox.md"],"required_strings":["DockerPathGuard","DockerPathTranslator","/mnt/poirot/user-data/"]},
    {"id":"agent-15","prompt":"请只根据本地资料解释 L4 memory middleware 为什么在 before_model 注入 recalled memories。","should_call_knowledge_search":true,"expected_sources":["memory_skill.md"],"required_strings":["before_model","recalled memories"]},
    {"id":"agent-16","prompt":"请用一句话问候用户，不要查询本地知识库，也不要提及项目架构。","should_call_knowledge_search":false,"expected_sources":[],"required_strings":[],"must_not_contain":["knowledge_search"]},
    {"id":"agent-17","prompt":"请查询本地资料比较 MCP fallback 与 Agentic RAG：前者解决工具可用性，后者解决本地资料检索。","should_call_knowledge_search":true,"expected_sources":["architecture.md","rag_config.md"],"required_strings":["fallback","knowledge_search","MCP"]},
    {"id":"agent-18","prompt":"轻量本地 RAG 是否已经接入 Chroma、Redis、Embedding 和 reranker？请查询后逐项谨慎回答。","should_call_knowledge_search":true,"expected_sources":["rag_config.md"],"required_strings":["Chroma","Redis","embeddings","reranker"],"required_any_groups":[["没有使用","does not use","未使用"]],"must_not_contain":["已经接入 Chroma"]},
    {"id":"agent-19","prompt":"请查询本地资料，列出 Poirot MCP 支持的三种 transport，并说明工具 fallback 的例子。","should_call_knowledge_search":true,"expected_sources":["architecture.md"],"required_strings":["stdio","sse","http","builtin ddg"]},
