    {"id":"fallback-09","category":"fallback","prompt":"Use the second candidate after the first fallback also fails.","setup":"primary=mcp_error; fallback_1=builtin_error; fallback_2=sandbox_success","acceptance":["tries candidates in order","uses third candidate","reports selected tool"]},
    {"id":"fallback-10","category":"fallback","prompt":"Prevent a transient primary error from contaminating a later healthy call.","setup":"call_1:primary_error,fallback_success; call_2:primary_success","acceptance":["records failure","allows later primary call","does not force stale fallback"]},
    {"id":"fallback-11","category":"fallback","prompt":"Handle a malformed primary tool response with a valid fallback response.","setup":"primary=invalid_payload; fallback=valid_payload","acceptance":["classifies invalid response","uses fallback","returns normalized payload"]},
