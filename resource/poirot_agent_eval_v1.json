    {"id":"fallback-06","category":"fallback","prompt":"Retry an unavailable remote search provider through the local search implementation.","setup":"primary:tavily=credential_error; fallback:ddg=success","acceptance":["classifies credential error","uses configured local fallback","returns source metadata"]},
    {"id":"fallback-07","category":"fallback","prompt":"Complete a file operation after the first sandbox candidate is unhealthy.","setup":"primary:sandbox_a=unhealthy; fallback:sandbox_b=success","acceptance":["selects healthy fallback","keeps requested operation","records health failure"]},
