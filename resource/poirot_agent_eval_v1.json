    {"id":"fallback-01","category":"fallback","prompt":"Search for a supplied topic after the primary web search tool times out.","setup":"primary:web_search=timeout; fallback:tavily_search=success","acceptance":["tries configured fallback","returns fallback result","records primary failure"]},
